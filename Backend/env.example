# Copy this file to ".env" and fill in your actual values
# NEVER commit the real .env file to GitHub

# MongoDB Atlas connection string
# Get this from: MongoDB Atlas → Connect → Connect your application
MONGO_URI=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@cluster0.xxxxx.mongodb.net/expense_tracker?retryWrites=true&w=majority

# Port the backend server will run on
PORT=5000

# Environment (change to "production" when deploying)
NODE_ENV=development
